# Generated or machine-owned files. Formatting these produces churn with no
# benefit: the tool that writes them will rewrite them in its own style anyway,
# and a reformatted lockfile buries real dependency changes in a huge diff.
#
# Prettier already skips anything in the ROOT .gitignore (v3 defaults
# --ignore-path to it), which is why .agent/ and node_modules are absent here.
# Nested .gitignore files are NOT consulted, so anything ignored by a
# per-package .gitignore still has to be repeated below.

pnpm-lock.yaml

# Convex codegen — regenerated by `convex dev`.
packages/backend/convex/_generated/

# Tauri codegen — regenerated by the build.
apps/tray/src-tauri/gen/

# Build output.
apps/web/dist/

# Expo codegen — rewritten by `expo start`. Ignored by apps/mobile/.gitignore,
# which Prettier does not read (see above).
apps/mobile/expo-env.d.ts
